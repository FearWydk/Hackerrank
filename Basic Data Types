// Basic Data Types
#include <iostream>
#include <cstdio>
using namespace std;

int main() {
    int    a;
    long   b;
    char   c;
    float  d;
    double e;
    //Scanf and Printf works faster then Cin and Cout when having to print a larger quantity of lines.
    scanf("%d %ld %c %f %lf", &a,&b,&c,&d,&e);
    printf("%d\n%ld\n%c\n%f\n%lf", a,b,c,d,e);
    return 0;
}
